# Discord OAuth2 credentials.
# Create an app at https://discord.com/developers/applications, open
# OAuth2 -> General, and copy the values below. Add the exact redirect URI
# from DISCORD_REDIRECT_URI to OAuth2 -> Redirects in the Discord app.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Google OAuth2 credentials.
# Create an "OAuth-Client-ID" (type "Web-Anwendung") at
# https://console.cloud.google.com/apis/credentials, then add the exact
# redirect URI from GOOGLE_REDIRECT_URI to "Autorisierte Redirect-URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Epic Games (Fortnite) OAuth2 credentials.
# Create a Product + "Epic Account Services" application at
# https://dev.epicgames.com/portal, then add the exact redirect URI from
# EPIC_REDIRECT_URI to that application's OAuth redirect URLs.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=http://localhost:8000/auth/epic/callback
# Optional: only needed if your app requires a specific deployment.
EPIC_DEPLOYMENT_ID=

# Öffentliche Adresse dieses Servers (z. B. https://scrimpass.onrender.com).
# Wird beim SP-Client-Download in den Dateinamen eingebettet, damit der Client
# weiß, wohin er sich verbinden soll. Lokal leer lassen; hinter einem Proxy
# (Render o. Ä.) unbedingt setzen.
PUBLIC_BASE_URL=

# Any long random string, used to sign session cookies.
SECRET_KEY=

# Im Produktivbetrieb (Render o. Ä. mit HTTPS) auf 1 setzen, damit das Session-Cookie
# nur noch über HTTPS gesendet wird. Lokal (http://localhost) leer/0 lassen, sonst
# funktioniert der Login im Dev-Server nicht.
SESSION_COOKIE_SECURE=

# Komma-getrennte Discord-User-IDs mit Admin-Zugriff (Match-Runden erstellen,
# Ergebnisse eintragen, Auszahlungsanfragen verwalten).
ADMIN_USER_IDS=

# Stripe (Zahlungsanbieter für Masterclass-Plan-Käufe).
# Dashboard -> Entwicklerprüfung/Developers -> API keys. Im Testmodus
# beginnen die Keys mit sk_test_/pk_test_, im Livemodus mit sk_live_/pk_live_.
# STRIPE_WEBHOOK_SECRET kommt aus Dashboard -> Entwickler -> Webhooks ->
# Endpunkt für <deine-domain>/webhook/stripe -> "Signing secret" (whsec_...),
# bzw. aus `stripe listen` für lokale Tests.
# "Mit Guthaben kaufen" im Shop läuft NICHT über Stripe — einmaliger Kauf,
# direkt aus dem Guthaben der Nutzer bezahlt, siehe README.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
